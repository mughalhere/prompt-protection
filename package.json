{
  "name": "prompt-protection",
  "version": "2.0.0",
  "description": "Prompt injection detection and LLM firewall for Node.js and browsers. Blocks jailbreaks, data exfiltration, and system prompt leaks. 117 rules, zero dependencies, TypeScript-first.",
  "license": "MIT",
  "author": "mughalhere",
  "homepage": "https://mughalhere.github.io/prompt-protection/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mughalhere/prompt-protection"
  },
  "bugs": {
    "url": "https://github.com/mughalhere/prompt-protection/issues"
  },
  "keywords": [
    "prompt-injection",
    "llm-security",
    "jailbreak",
    "ai-safety",
    "prompt-sanitization",
    "openai",
    "anthropic",
    "langchain",
    "prompt-protection",
    "llm-guard",
    "ai-security",
    "llm-firewall",
    "guardrails",
    "owasp-llm",
    "prompt-security",
    "injection-detection",
    "chatbot-security",
    "llm-safety",
    "ai-red-team",
    "gpt"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./middleware/express": {
      "import": {
        "types": "./dist/middleware/express.d.ts",
        "default": "./dist/middleware/express.js"
      },
      "require": {
        "types": "./dist/middleware/express.d.cts",
        "default": "./dist/middleware/express.cjs"
      }
    },
    "./middleware/nextjs": {
      "import": {
        "types": "./dist/middleware/nextjs.d.ts",
        "default": "./dist/middleware/nextjs.js"
      },
      "require": {
        "types": "./dist/middleware/nextjs.d.cts",
        "default": "./dist/middleware/nextjs.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/usePromptProtection.d.ts",
        "default": "./dist/react/usePromptProtection.js"
      },
      "require": {
        "types": "./dist/react/usePromptProtection.d.cts",
        "default": "./dist/react/usePromptProtection.cjs"
      }
    },
    "./adapters/claude": {
      "import": {
        "types": "./dist/adapters/claude.d.ts",
        "default": "./dist/adapters/claude.js"
      },
      "require": {
        "types": "./dist/adapters/claude.d.cts",
        "default": "./dist/adapters/claude.cjs"
      }
    },
    "./adapters/openai": {
      "import": {
        "types": "./dist/adapters/openai.d.ts",
        "default": "./dist/adapters/openai.js"
      },
      "require": {
        "types": "./dist/adapters/openai.d.cts",
        "default": "./dist/adapters/openai.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp/server.d.ts",
        "default": "./dist/mcp/server.js"
      },
      "require": {
        "types": "./dist/mcp/server.d.cts",
        "default": "./dist/mcp/server.cjs"
      }
    },
    "./adapters/vercel": {
      "import": {
        "types": "./dist/adapters/vercel.d.ts",
        "default": "./dist/adapters/vercel.js"
      },
      "require": {
        "types": "./dist/adapters/vercel.d.cts",
        "default": "./dist/adapters/vercel.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest --config jest.config.cjs",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:watch": "jest --config jest.config.cjs --watch",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test && npm run typecheck",
    "bench": "npm run build && node bench/run.mjs"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "express": ">=4.0.0",
    "openai": ">=4.0.0",
    "react": ">=17.0.0",
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "ai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@testing-library/react": "^16.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "ai": "^7.0.93",
    "eslint": "^8.57.0",
    "express": "^4.21.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "openai": "^7.4.0",
    "prettier": "^3.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0"
  },
  "bin": {
    "prompt-protection-mcp": "./dist/mcp/bin.cjs"
  }
}
